# 复制为 .env.local，填写本机配置；不要提交真实密钥。
APP_ORIGIN=http://127.0.0.1:3000
DEMO_ACCESS_TOKEN=replace-with-a-private-demo-password
MODEL_API_URL=https://tokenhub.tencentmaas.com/v1/chat/completions
MODEL_API_KEY=
MODEL_NAME=
# 仅在代理受你控制且覆盖 X-Real-IP 时启用；默认所有来源共享限频。
TRUST_PROXY=false

# Suno 音乐生成（Kie.ai 第三方接口）；留空时仅可本地导入伴奏，不产生调用。
# Key 只留在服务端；网页填写上方 DEMO_ACCESS_TOKEN，不填写 API Key。
MUSIC_API_KEY=
MUSIC_MODEL=V6
MUSIC_MAX_JOBS_PER_DAY=12
# 单个本机 Node 进程使用，任务和音频位于已被 gitignore 排除的目录。
MUSIC_DATA_DIR=.music-data
